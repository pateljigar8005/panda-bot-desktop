{
  "name": "panda-bot-desktop",
  "productName": "Panda Bot",
  "version": "0.1.0",
  "private": true,
  "description": "Panda Bot: runs sub-accounts on the platform, locally on your computer",
  "author": "Panda Bot",
  "main": "src/main/index.js",
  "scripts": {
    "postinstall": "install-electron",
    "dev": "concurrently -k -n ui,app -c cyan,magenta \"vite --config renderer/vite.config.mts\" \"wait-on tcp:127.0.0.1:5173 && node scripts/electron.js --dev-url=http://127.0.0.1:5173\"",
    "build": "vite build --config renderer/vite.config.mts",
    "start": "npm run build && node scripts/electron.js",
    "typecheck": "tsc -b renderer",
    "test": "node --test test/*.test.js",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win"
  },
  "devDependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tanstack/react-query": "^5.104.0",
    "@tanstack/react-table": "^8.21.3",
    "@types/node": "^26.6.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.5",
    "date-fns": "^4.4.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "lucide-react": "^1.49.0",
    "postcss": "^8.5.28",
    "react": "^18.3.1",
    "react-day-picker": "^9.14.0",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.89.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^2.15.4",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.9.3",
    "vite": "^8.3.1",
    "wait-on": "^9.5.1",
    "zod": "^3.25.76",
    "zustand": "^5.0.15"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "https-proxy-agent": "^9.1.0",
    "i18next": "^26.4.2",
    "nodemailer": "^10.0.13",
    "react-i18next": "^17.0.15",
    "socks-proxy-agent": "^10.1.0"
  }
}
